<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- MAIN PROFILE -->
    <key>PayloadType</key>
    <string>Configuration</string>

    <key>PayloadVersion</key>
    <integer>1</integer>

    <key>PayloadIdentifier</key>
    <string>com.example.ipodhtml</string>

    <key>PayloadUUID</key>
    <string>11111111-2222-3333-4444-555555555555</string>

    <key>PayloadDisplayName</key>
    <string>iPod HTML Clip</string>

    <key>PayloadOrganization</key>
    <string></string>

    <key>PayloadDescription</key>
    <string>Web Clip for iPod HTML site.</string>

    <key>PayloadContent</key>
    <array>
        <!-- WEB CLIP PAYLOAD -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>

            <key>PayloadVersion</key>
            <integer>1</integer>

            <key>PayloadIdentifier</key>
            <string>com.example.ipodhtml.webclip</string>

            <key>PayloadUUID</key>
            <string>66666666-7777-8888-9999-AAAAAAAAAAAA</string>

            <key>PayloadDisplayName</key>
            <string>iPod HTML Web Clip</string>

            <key>PayloadDescription</key>
            <string>Home-screen Web Clip.</string>

            <!-- Home screen title -->
            <key>Label</key>
            <string>iPod HTML</string>

            <key>URL</key>
            <string>https://minh6079.github.io/iPod-html/</string>

            <key>FullScreen</key>
            <true/>

            <key>Precomposed</key>
            <true/>

            <key>IsRemovable</key>
            <true/>

            <!-- Icon Base64 placeholder -->
            <key>Icon</key>
            <data>
            
            </data>
        </dict>
    </array>
</dict>
</plist>
